NOTION_TOKEN=secret_xxx_your_notion_integration_token
# Database UUID from the database URL (with or without hyphens). Must be a database, not a normal page.
NOTION_DATABASE_ID=your_database_id_without_hyphens_or_with_hyphens
# Optional: if "true", sync exits with error when the database returns zero rows (for CI alerts).
# NOTION_FAIL_ON_EMPTY=true
PORT=3000
